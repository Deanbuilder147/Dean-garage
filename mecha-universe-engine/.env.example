# 机甲战棋 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 命令：cp .env.example .env

# ===========================================
# 数据库配置
# ===========================================
# 适配器选择: sqlite (默认) 或 postgres
DB_ADAPTER=sqlite

# PostgreSQL 配置 (Docker 部署时使用)
POSTGRES_DB=mecha_battle
POSTGRES_USER=mecha_user
POSTGRES_PASSWORD=<在此粘贴 openssl rand -base64 32 的输出>

# ===========================================
# JWT 认证配置
# ===========================================
JWT_SECRET=<在此粘贴 openssl rand -base64 64 的输出>

# ===========================================
# 运行环境
# ===========================================
NODE_ENV=production
# NODE_ENV=development  # 开发环境

# ===========================================
# 服务端口配置
# ===========================================
AUTH_SERVICE_PORT=3001
HANGAR_SERVICE_PORT=3002
MAP_SERVICE_PORT=3003
COMBAT_SERVICE_PORT=3004
COMM_SERVICE_PORT=3005
ONLINE_BATTLE_SERVICE_PORT=3006
FRONTEND_PORT=8081

# ===========================================
# 数据库连接 URL
# ===========================================
# SQLite 模式下忽略此值
# Docker 内部: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# 本地开发: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://mecha_user:mecha_user_password@postgres:5432/mecha_battle

# ===========================================
# 服务间通信 URL
# ===========================================
# Docker 网络使用服务名:
# AUTH_SERVICE_URL=http://auth-service:3001
# 本地开发使用 localhost:
AUTH_SERVICE_URL=http://localhost:3001
HANGAR_SERVICE_URL=http://localhost:3002
MAP_SERVICE_URL=http://localhost:3003
COMBAT_SERVICE_URL=http://localhost:3004
COMM_SERVICE_URL=http://localhost:3005
ONLINE_BATTLE_SERVICE_URL=http://localhost:3006

# ===========================================
# CORS 配置 - 允许的域名列表（逗号分隔）
# ===========================================
# 生产环境请修改为你的实际域名
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080,https://yourdomain.com
