    "sweep": {
      "entryType": "skill",
      "name": "扫射",
      "name_en": "Sweep",
      "description": "纯 Segment 模型：掷 1d6。1-3 点精准命中单体 -2；4-6 点范围攻击，对所有敌方均摊伤害。",
      "ap_cost": 1,
      "category": "ranged",
      "min_range": 1,
      "max_range": 3,
      "damage_kind": "kinetic",
      "attack_stat": "ranged",
      "action_type": "passive",
      "base_damage": 0,
      "__segment_model__": true,
      "roll": {
        "mode": "dice",
        "dice_type": "1d6",
        "segments": [
          {
            "lower": 1,
            "upper": 3,
            "label": "精准单体",
            "effects": [
              {
                "type": "damage",
                "flat_value": -2,
                "target_scope": "SINGLE_ENEMY",
                "damage_mode": "override",
                "split_mode": "none"
              }
            ]
          },
          {
            "lower": 4,
            "upper": 6,
            "label": "范围均摊",
            "effects": [
              {
                "type": "damage",
                "flat_value": -6,
                "target_scope": "AREA_ENEMY",
                "damage_mode": "override",
                "split_mode": "equal"
              }
            ]
          }
        ]
      },
      "engine_meta": {
        "model": "pure_segment",
        "refactored_at": "2026-08-07",
        "note": "改造为纯 Segment 模型：移除旧 branch/确定性残留（aoe_mode/map_cannon/mcShapes/顶层 effects/base_damage），伤害全部由 roll.segments[].effects 经 effectExecutor 结算；谓语 passive 仅作承载，不重复扣血。"
      }
    },
